# Immutable image produced by CI, for example ghcr.io/<github-owner>/unibot:<commit-sha>
ROBOTSPACE_IMAGE=

# A DNS A record for this exact name must point to the VPS before Caddy starts.
ROBOTSPACE_DOMAIN=

DATABASE_URL=
DIRECT_DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=
INTEGRATION_CREDENTIALS_KEYRING=
