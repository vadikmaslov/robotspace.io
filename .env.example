# RobotSpace Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to Git. Add to .gitignore.

# ============================================================
# DATABASE
# ============================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL=

# Direct connection for migrations (bypasses connection pooler if used)
DIRECT_DATABASE_URL=

# ============================================================
# AUTHENTICATION
# ============================================================

# Secret used to sign session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email of first admin user; bootstrapped into admin_users table on first run
BOOTSTRAP_ADMIN_EMAIL=

# Single-admin password. Keep the real value only in the protected server env.
ADMIN_PASSWORD=

# Shared token for private worker-to-web requests. If absent, ADMIN_PASSWORD is used temporarily.
# Keep the real value only in the protected server env.
INTERNAL_AGENT_TOKEN=

# Loopback address of the web service that receives AI summary requests from the worker.
INTERNAL_AGENT_SUMMARY_URL=http://127.0.0.1:3001/api/internal/insights-summary

# ============================================================
# ENCRYPTION
# ============================================================

# Integration credentials keyring (JSON with ACTIVE key and previous keys)
# Format: {"active":{"id":"k1","key":"base64..."},"previous":[]}
INTEGRATION_CREDENTIALS_KEYRING=

# Active key ID from keyring above
INTEGRATION_CREDENTIALS_ACTIVE_KEY_ID=

# ============================================================
# S3 STORAGE (Beget or compatible)
# ============================================================

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================
# EMAIL
# ============================================================

# SMTP or email provider connection string
# Format: smtp://user:password@host:port
EMAIL_TRANSPORT_URL=

# ============================================================
# CAPTCHA
# ============================================================

CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ============================================================
# APPLICATION
# ============================================================

# Public base URL of the site (no trailing slash)
APP_BASE_URL=https://robotspace.io

# ============================================================
# MAP
# ============================================================

# MapLibre style URL (tile provider)
# Leave empty to use map without basemap
MAP_STYLE_URL=

# ============================================================
# AI PROVIDERS (optional; can also be configured via admin UI)
# ============================================================

# OpenAI API key
OPENAI_API_KEY=

# DeepSeek API key
DEEPSEEK_API_KEY=

# GLM API key
GLM_API_KEY=

# OpenAI-compatible provider (optional)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
